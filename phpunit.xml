<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Suite "Seeders": valida "php artisan db:seed" contra o banco configurado
            no .env do projeto (e nao contra o banco de laboratorio abaixo).
            E DESTRUTIVA: trunca as tabelas de dominio. Rode com:
            php artisan test [dois hifens]testsuite=Seeders
        -->
        <testsuite name="Seeders">
            <directory>tests/Seeders</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Alvo do banco de teste fixado aqui de proposito: host, porta e nome
            diferentes dos de desenvolvimento impedem que a suite (que usa
            RefreshDatabase) apague o banco de dev por engano.

            DB_USERNAME e DB_PASSWORD NAO ficam neste arquivo: ele e versionado.
            As credenciais vem do .env local, que esta no .gitignore.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5434"/>
        <env name="DB_DATABASE" value="projeto_base_test"/>
        <env name="SESSION_DOMAIN" value="null"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
