# =============================================================================
# .gitignore — Sistema PEI
# Regra: só vai para o repositório o que a aplicação precisa para ser instalada
# e executada. Segredo, dependência baixável, artefato gerado e arquivo de
# ferramenta local ficam de fora.
# =============================================================================

# --- Segredos: NADA aqui pode ser versionado ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
/auth.json
/storage/*.key
credentials.json
service-account*.json
*service_account*.json

# --- Dependências (reinstaláveis por composer/npm) ---------------------------
/vendor
/node_modules

# --- Artefatos gerados em build/execução -------------------------------------
/public/build
/public/hot
/public/storage
/storage/pail
/bootstrap/cache/*.php
*.log
/.phpunit.cache
.phpunit.result.cache
/temp
*.tmp
*.bak
~$*

# --- Banco local -------------------------------------------------------------
*.sqlite
*.sqlite-journal
/database/database.sqlite

# --- Harness do assistente ---------------------------------------------------
# O harness É a regra da equipe: permissões, hooks e guidelines vão junto com o
# código, ou não sobrevivem a um clone. Fica de fora só o que é da máquina de
# quem edita — e a nota de segurança, que não se publica em repositório público.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
/.claude/settings.local.json
/.claude/seguranca-em-aberto.md
/.rtk/*
!/.rtk/filters.toml
/.agent
/ai
/gemini
AGENTS.md
GEMINI.md
RTK.md

# --- Documentação ------------------------------------------------------------
# Os .md de documentacao/ SÃO versionados: acompanham o deploy.
# Binários de escritório, não — incham o repositório e não geram diff legível.
/documentacao/**/*.docx
/documentacao/**/*.doc
/documentacao/**/*.xlsx
/documentacao/**/*.xls
/documentacao/**/*.pptx
/documentacao/**/*.pdf
/docs
MIGRATIONS_SUMMARY.md
README_ORIGINAL.md

# --- Scripts de depuração pontuais -------------------------------------------
/debug_calc.php

# --- Editores e IDEs ---------------------------------------------------------
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json

# --- Sistema operacional -----------------------------------------------------
.DS_Store
Thumbs.db

# --- Ambientes locais Laravel ------------------------------------------------
Homestead.json
Homestead.yaml
