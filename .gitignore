# =============================================================================
# .gitignore — Sistema PEI
# Regra: só vai para o repositório o que a aplicação precisa para ser instalada
# e executada. Segredo, dependência baixável, artefato gerado e arquivo de
# ferramenta local ficam de fora.
# =============================================================================

# --- Segredos: NADA aqui pode ser versionado ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
/auth.json
/storage/*.key
credentials.json
service-account*.json
*service_account*.json

# --- Dependências (reinstaláveis por composer/npm) ---------------------------
/vendor
/node_modules

# --- Artefatos gerados em build/execução -------------------------------------
/public/build
/public/hot
/public/storage
/storage/pail
/bootstrap/cache/*.php
*.log
/.phpunit.cache
.phpunit.result.cache
/temp
*.tmp
*.bak
~$*

# --- Banco local -------------------------------------------------------------
*.sqlite
*.sqlite-journal
/database/database.sqlite

# --- Harness do assistente de IA ---------------------------------------------
# Ferramental de quem desenvolve, NÃO produto. Decisão do gestor: o harness
# fica na máquina de quem edita e NÃO vai para o repositório remoto, que é
# público. Ele carrega premissas de trabalho, o perfil de quem lê as entregas,
# o mapa da arquitetura, permissões e hooks. O que é regra do CÓDIGO vive em
# CONTRIBUTING.md, que é versionado.
#
# O que do harness CONTINUA versionado, de propósito:
#   - laravel/boost em require-dev do composer.json/lock (dependência; o
#     servidor instala com --no-dev e não o recebe);
#   - documentacao/harness/ — apesar do nome, é documentação do PRODUTO
#     (manual operacional, documentação técnica, dicionário) linkada no README.

# Claude Code: configuração, hooks, skills, agentes, ralph e instruções
/.claude/
/CLAUDE.md
/CLAUDE.local.md
**/CLAUDE.local.md

# Laravel Boost: MCP, escolha de agentes e diretrizes geradas
/.mcp.json
/boost.json
/.ai/
/ai

# Outros agentes e IDEs com IA (instruções, regras e skills locais)
AGENTS.md
agents.md
GEMINI.md
/.agent
/.agents/
/.gemini/
/gemini
/.codex/
/.pi/
/opencode.json
/.opencode/
/.cursor/
/.cursorrules
/.windsurf/
/.windsurfrules
/.junie/
/.kiro/
/.clinerules
/.roo/
/.continue/
/.aider*
/.github/copilot-instructions.md
/.github/instructions/
/.github/prompts/

# RTK (Rust Token Killer)
/.rtk/
RTK.md

# Ferramentas de apoio ao desenvolvimento (auditoria de UI e afins)
ferramentas/

# --- Documentação ------------------------------------------------------------
# Os .md de documentacao/ SÃO versionados: acompanham o deploy.
# Binários de escritório, não — incham o repositório e não geram diff legível.
/documentacao/**/*.docx
/documentacao/**/*.doc
/documentacao/**/*.xlsx
/documentacao/**/*.xls
/documentacao/**/*.pptx
/documentacao/**/*.pdf

# Exceção: documentacao/pdf/ não é documentação de apoio, é ativo da aplicação.
# O DocumentosController serve estes arquivos por rota (/guia-gppei e
# /documentos/projetos). Ficando de fora do repositório, todo deploy novo
# nascia com 404 na tela do guia. Só esta pasta é versionada; os PDFs soltos
# no resto de documentacao/ continuam ignorados.
!/documentacao/pdf/*.pdf

/docs
MIGRATIONS_SUMMARY.md
README_ORIGINAL.md

# --- Scripts de depuração pontuais -------------------------------------------
/debug_calc.php

# --- Editores e IDEs ---------------------------------------------------------
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json

# --- Sistema operacional -----------------------------------------------------
.DS_Store
Thumbs.db

# --- Ambientes locais Laravel ------------------------------------------------
Homestead.json
Homestead.yaml
